{
  "name": "@mersal/api",
  "version": "0.1.0",
  "private": true,
  "description": "Mersal REST API (NestJS + Prisma).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \".test-dist/src/**/*.spec.js\"",
    "lint": "eslint src",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "prisma": {
    "seed": "pnpm run db:seed"
  },
  "dependencies": {
    "@mersal/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "stripe": "^18.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "6.19.3",
    "typescript": "~5.9.3"
  }
}
