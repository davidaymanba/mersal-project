# Copy to apps/api/.env and apps/web/.env.local (pnpm setup does this for you).

# --- API ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://mersal:mersal@localhost:55432/mersal?schema=public
REDIS_URL=redis://localhost:56379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAIL_FROM="Mersal <hello@mersal.local>"

# Uploads (KYC documents, parcel photos). "local" stores files under UPLOAD_DIR;
# an S3-compatible driver can be added behind the same StorageService.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Stripe test mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Demo mode shortens timers (48h hold -> minutes) so the full flow can be shown live.
DEMO_MODE=true

# Local only: end-to-end tests send this in x-e2e-key to skip rate limits. Leave empty in production.
E2E_BYPASS_KEY=local-e2e

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
